# File nay chi phuc vu cac script Prisma chay nham vao Postgres PRODUCTION
# (pnpm db:migrate:status:production / db:deploy:production).
# KHONG commit gia tri that; copy sang .env.production (da nam trong
# .gitignore) va dien connection string that, lay tu Render dashboard
# (Database > Connections > External Database URL).
#
# db:deploy:production chi chay "prisma migrate deploy" — idempotent,
# forward-only, chi ap dung migration con thieu, khong dung toi du lieu
# hien co. Luon chay db:migrate:status:production truoc de xem truoc migration
# nao se duoc ap dung.

DATABASE_URL=postgresql://<user>:<password>@<render-postgres-host>/<database>?schema=public&sslmode=require
